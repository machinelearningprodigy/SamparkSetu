export interface Item {
  id?: string
  created_at: string
  name: string
  category: string
  description: string
  location: string
  date: string
  type: "lost" | "found"
  status: "pending" | "matched" | "claimed" | "closed"
  user_id: string
  images: string[]
  condition?: string
}

export interface Match {
  id?: string
  created_at: any
  lost_item_id: string
  found_item_id: string
  status: "suggested" | "pending" | "confirmed" | "rejected"
  finder_confirmed?: boolean
  loser_confirmed?: boolean
  rejected_by?: string
  rejection_reason?: string
  userRole?: string
  otherUser?: Profile
}

export interface Profile {
  id: string
  created_at: string
  updated_at: string
  username: string
  full_name: string
  avatar_url: string
  email: string
  is_admin: boolean
}
